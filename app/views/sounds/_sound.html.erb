<tr id="<%= dom_id(sound) %>" class="hover:bg-slate-50">
  <td class="px-4 py-3 font-medium text-slate-900"><%= sound.label %></td>
  <td class="px-4 py-3 text-slate-600">
    <% if sound.audio.attached? %>
      <div><%= sound.audio.filename %></div>
      <div class="text-xs text-slate-500"><%= number_to_human_size(sound.audio.byte_size) %></div>
      <%# preload="none" so listing the page doesn't stream every track. %>
      <audio class="mt-1 h-8" controls preload="none" src="<%= track_path(sound) %>"></audio>
    <% else %>
      <span class="text-slate-400">—</span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-slate-500"><%= time_ago_in_words(sound.updated_at) %> ago</td>
  <td class="px-4 py-3 text-right whitespace-nowrap">
    <%= link_to "Edit", edit_sound_path(sound), class: "text-sky-600 hover:text-sky-700" %>
    <%= button_to "Delete", sound, method: :delete,
      class: "ml-3 text-red-600 hover:text-red-700",
      form: { class: "inline", data: { turbo_confirm: "Remove #{sound.label}?" } } %>
  </td>
</tr>

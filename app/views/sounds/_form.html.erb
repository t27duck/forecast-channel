<%= form_with model: sound, class: "space-y-5" do |f| %>
  <% if sound.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-medium"><%= pluralize(sound.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% sound.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :kind, "Sound", class: "block text-sm font-medium text-slate-700" %>
    <p class="text-xs text-slate-500">Where and when this track plays.</p>
    <%= f.select :kind, Sound::KINDS.map { |kind| [ Sound::LABELS[kind], kind ] },
      { include_blank: "Choose a sound" },
      class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
  </div>

  <div>
    <%= f.label :audio, "MP3", class: "block text-sm font-medium text-slate-700" %>
    <% if sound.audio.attached? %>
      <p class="text-xs text-slate-500">
        Currently <%= sound.audio.filename %> (<%= number_to_human_size(sound.audio.byte_size) %>).
        Choosing a file replaces it.
      </p>
    <% end %>
    <%= f.file_field :audio, accept: "audio/mpeg",
      class: "mt-1 block w-full text-sm text-slate-600 file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-4 file:py-2 file:text-sm file:font-medium file:text-slate-700 hover:file:bg-slate-200" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit sound.new_record? ? "Upload sound" : "Save changes",
      class: "inline-flex items-center rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" %>
    <%= link_to "Cancel", sounds_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  </div>
<% end %>

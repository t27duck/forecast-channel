<% content_for :title, "Sounds" %>

<div class="mx-auto max-w-5xl px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Sounds</h1>
      <p class="text-sm text-slate-500">Background music for the forecast screens and the globe.</p>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "New sound", new_sound_path,
        class: "inline-flex items-center rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" %>
    </div>
  </div>

  <% if @sounds.any? %>
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Sound</th>
            <th class="px-4 py-3">File</th>
            <th class="px-4 py-3">Uploaded</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= render @sounds %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <p class="text-slate-500">No sounds yet — the app runs silently until a track is uploaded.</p>
      <%= link_to "Upload your first track", new_sound_path,
        class: "mt-3 inline-block text-sm font-medium text-sky-600 hover:text-sky-700" %>
    </div>
  <% end %>

  <% missing = Sound::KINDS - @sounds.map(&:kind) %>
  <% if @sounds.any? && missing.any? %>
    <p class="mt-4 text-sm text-slate-500">
      Still silent:
      <%= safe_join(missing.map { |kind| link_to Sound::LABELS[kind], new_sound_path(kind: kind),
        class: "font-medium text-sky-600 hover:text-sky-700" }, ", ") %>
    </p>
  <% end %>
</div>

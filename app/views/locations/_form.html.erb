<%= form_with model: location, class: "space-y-5" do |f| %>
  <% if location.errors.any? %>
    <div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-medium"><%= pluralize(location.errors.count, "error") %> prevented saving:</p>
      <ul class="mt-1 list-disc list-inside">
        <% location.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :name, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :latitude, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :latitude, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm tabular-nums focus:border-sky-500 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :longitude, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :longitude, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm tabular-nums focus:border-sky-500 focus:ring-sky-500" %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :admin1, "Region", class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :admin1, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    </div>
    <div>
      <%= f.label :country, class: "block text-sm font-medium text-slate-700" %>
      <%= f.text_field :country, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
    </div>
  </div>

  <div>
    <%= f.label :timezone, class: "block text-sm font-medium text-slate-700" %>
    <%= f.text_field :timezone, class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
  </div>

  <%# Captured from geocoding; kept on the record but not directly edited. %>
  <%= f.hidden_field :country_code %>
  <%= f.hidden_field :elevation %>
  <%= f.hidden_field :population %>
  <%= f.hidden_field :open_meteo_id %>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit location.new_record? ? "Add location" : "Save changes",
      class: "inline-flex items-center rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" %>
    <%= link_to "Cancel", locations_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
  </div>
<% end %>

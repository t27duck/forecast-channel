<% content_for :title, @location.name %>
<% content_for :hide_app_nav, true %>
<%# Every forecast page plays the "current" track, whichever location it shows. %>
<% content_for :music_zone, "current" %>

<% if @auto_locate %>
  <%= form_with url: current_location_path, method: :post,
    data: { controller: "geolocate" }, class: "hidden" do %>
    <%= hidden_field_tag :latitude, nil, data: { geolocate_target: "latitude" } %>
    <%= hidden_field_tag :longitude, nil, data: { geolocate_target: "longitude" } %>
  <% end %>
<% end %>

<div class="wii" data-controller="forecast press" data-forecast-default-value="current">
  <%# Fixed silver top bar — its ▲ label updates to the panel above. %>
  <div class="wii-top">
    <div class="wii-bar__slot">
      <button type="button" class="wii-mute" aria-label="Mute or unmute the music"
        data-controller="mute" data-mute-jukebox-outlet="#jukebox" data-action="mute#toggle">
        <svg class="wii-mute__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor"/>
          <g class="wii-mute__waves" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M16 9.5a3.5 3.5 0 0 1 0 5"/>
            <path d="M18.5 7a7 7 0 0 1 0 10"/>
          </g>
          <line class="wii-mute__slash" x1="16" y1="7.5" x2="21.5" y2="16.5"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <div class="wii-bar__slot wii-bar__slot--center">
      <button type="button" class="wii-arrow" data-action="forecast#prev" data-forecast-target="prevControl" hidden>
        <span class="wii-arrow__glyph">&#9650;</span>
        <span class="wii-arrow__label" data-forecast-target="prevLabel"></span>
      </button>
    </div>
    <div class="wii-bar__slot wii-bar__slot--right">
      <%= link_to "Settings", settings_path, class: "wii-chrome-link" %>
    </div>
  </div>

  <%# Fixed green header — the title updates to the active panel; location stays. %>
  <div class="wii-header">
    <div class="wii-header__title" data-forecast-target="title">Current</div>
    <div class="wii-header__location"><%= @location.name %></div>
  </div>

  <div class="wii-viewport">
    <div class="wii__track" data-forecast-target="track">
      <%= render "locations/panels/uv", location: @location %>
      <%= render "locations/panels/air_quality", location: @location %>
      <%= render "locations/panels/laundry", location: @location %>
      <%= render "locations/panels/current", location: @location %>
      <%= render "locations/panels/today", location: @location %>
      <%= render "locations/panels/tomorrow", location: @location %>
      <%= render "locations/panels/five_day", location: @location %>
    </div>
  </div>

  <%# Fixed footer credit + timestamp. %>
  <div class="wii-footerline">
    <span class="wii-credit">supported by Open-Meteo</span>
    <% if (stamp = as_of(@location.weather_refreshed_at, @location.timezone)) %>
      <span class="wii-asof"><%= stamp %></span>
    <% end %>
  </div>

  <%# Fixed silver bottom bar — its ▼ label updates to the panel below. %>
  <div class="wii-bottom">
    <div class="wii-bar__slot"><%= link_to "Locations", locations_path, class: "wii-chrome-link" %></div>
    <div class="wii-bar__slot wii-bar__slot--center">
      <button type="button" class="wii-arrow" data-action="forecast#next" data-forecast-target="nextControl" hidden>
        <span class="wii-arrow__label" data-forecast-target="nextLabel"></span>
        <span class="wii-arrow__glyph">&#9660;</span>
      </button>
    </div>
    <div class="wii-bar__slot wii-bar__slot--right">
      <%# From your own location, centre the globe on it; from elsewhere, resume where you left the map. %>
      <%= link_to "Globe", (@is_current_location ? map_path(location: @location.slug) : map_path), class: "wii-chrome-link" %>
    </div>
  </div>
</div>

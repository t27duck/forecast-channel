<% content_for :title, "New location" %>

<div class="mx-auto max-w-2xl px-4 py-8">
  <h1 class="text-2xl font-semibold text-slate-900 mb-1">New location</h1>
  <p class="text-sm text-slate-500 mb-6">Search for a place to capture its coordinates, then review and save.</p>

  <section class="mb-8 rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-700 mb-3">Find a place</h2>

    <%= form_with url: search_locations_path, method: :get,
      data: { turbo_frame: "location_search_results" }, class: "flex gap-2" do |f| %>
      <%= f.search_field :query, value: params[:query], placeholder: "e.g. Berlin",
        class: "block w-full rounded-md border border-slate-300 px-3 py-2 shadow-sm focus:border-sky-500 focus:ring-sky-500" %>
      <%= f.submit "Search",
        class: "shrink-0 rounded-md bg-slate-800 px-4 py-2 text-sm font-medium text-white hover:bg-slate-900" %>
    <% end %>

    <%= turbo_frame_tag "location_search_results", class: "block mt-4" %>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5">
    <h2 class="text-sm font-medium text-slate-700 mb-4">Location details</h2>
    <%= render "form", location: @location %>
  </section>
</div>

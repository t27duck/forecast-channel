<% content_for :title, "Locations" %>

<div class="mx-auto max-w-5xl px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-semibold text-slate-900">Locations</h1>
      <p class="text-sm text-slate-500">Places tracked on the Forecast globe.</p>
    </div>
    <div class="flex items-center gap-2">
      <% if @locations.any? %>
        <%= button_to "Refresh all", refresh_all_locations_path,
          class: "inline-flex items-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
      <% end %>
      <%= link_to "New location", new_location_path,
        class: "inline-flex items-center rounded-md bg-sky-600 px-4 py-2 text-sm font-medium text-white hover:bg-sky-700" %>
    </div>
  </div>

  <% if @locations.any? %>
    <div class="overflow-hidden rounded-lg border border-slate-200 bg-white">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Location</th>
            <th class="px-4 py-3">Coordinates</th>
            <th class="px-4 py-3">Current</th>
            <th class="px-4 py-3">Updated</th>
            <th class="px-4 py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <%= render @locations %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
      <p class="text-slate-500">No locations yet.</p>
      <%= link_to "Add your first location", new_location_path,
        class: "mt-3 inline-block text-sm font-medium text-sky-600 hover:text-sky-700" %>
    </div>
  <% end %>
</div>

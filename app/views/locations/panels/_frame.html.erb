<%#
  A forecast panel body — the only part that slides. The silver bars, green
  header, and footer are fixed chrome rendered once in locations/show. Used as a
  partial layout:
    render layout: "locations/panels/frame", locals: { key:, title: } do ... end
  data-title feeds the fixed header + silver-bar labels via the forecast controller.
%>
<div class="wii-panel-body" data-panel="<%= key %>" data-title="<%= title %>" data-forecast-target="panel">
  <%= yield %>
</div>

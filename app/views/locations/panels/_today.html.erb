<% forecast = location.today_forecast %>
<%= render layout: "locations/panels/frame", locals: { key: "today" } do %>
  <%# id so a refresh morph matches this element rather than rebuilding it, which
      would drop the is-open class the controller re-asserts. %>
  <div class="wii-sixhour-zone" id="sixhour_today" data-controller="sixhour"
    data-action="click->sixhour#toggle forecast:dismiss@window->sixhour#close"
    data-sixhour-day-value="<%= weekday_name(forecast["date"]) %>">
    <div class="wii-conditions">
      <div class="wii-conditions__text">
        <div class="wii-temp wii-temp--yellow"><%= forecast_temperature(forecast["high"]) %></div>
        <div class="wii-condition"><%= forecast["condition_label"].presence || "Not available" %></div>
      </div>
      <div class="wii-conditions__icon"><%= weather_icon(forecast["condition_code"], size: 160) %></div>
    </div>
    <%= render "locations/panels/stats", stats: [
      [ "Feels like", apparent_range(forecast) ],
      [ "Wind", wind_display(forecast["wind_speed"], forecast["wind_direction"]) ],
      [ "Sunrise", forecast_time(forecast["sunrise"]) ],
      [ "Sunset", forecast_time(forecast["sunset"]) ]
    ] %>
    <%= render "locations/panels/six_hour", location: location, day: "today" %>
  </div>
<% end %>

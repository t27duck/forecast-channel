<%= render layout: "locations/panels/frame",
  locals: { key: "five_day", title: "5-Day Forecast" } do %>
  <% if location.five_day_forecast.present? %>
    <div class="wii-fiveday">
      <% location.five_day_forecast.each do |day| %>
        <div class="wii-day">
          <div class="<%= class_names("wii-day__name", "wii-day__name--weekend" => weekend?(day["date"])) %>"><%= weekday_abbr(day["date"]) %></div>
          <div class="wii-day__body">
            <div class="wii-day__icon"><%= weather_icon(day["condition_code"], size: 96) %></div>
            <div class="wii-day__high"><%= forecast_temperature(day["high"], degree: false) %></div>
            <div class="wii-day__low"><%= forecast_temperature(day["low"], degree: false) %></div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="wii-empty">5-day forecast not available yet.</div>
  <% end %>
<% end %>

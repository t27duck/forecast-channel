<%= render layout: "locations/panels/frame", locals: { key: "current" } do %>
  <div class="wii-conditions">
    <div class="wii-conditions__text">
      <div class="wii-temp wii-temp--white"><%= forecast_temperature(location.current_temperature) %></div>
      <div class="wii-condition"><%= location.current_condition_name %></div>
    </div>
    <div class="wii-conditions__icon"><%= weather_icon(location.current_condition_code, size: 160) %></div>
  </div>
  <%= render "locations/panels/stats", stats: [
    [ "Feels like", forecast_temperature(location.current_apparent_temperature, fallback: nil) ],
    [ "Humidity", location.current_humidity && "#{location.current_humidity}%" ],
    [ "Rain", location.current_precipitation_probability && "#{location.current_precipitation_probability}%" ],
    [ "Wind", wind_display(location.current_wind_speed, location.current_wind_direction) ],
    [ "Sunrise", forecast_time(location.today_forecast["sunrise"]) ],
    [ "Sunset", forecast_time(location.today_forecast["sunset"]) ]
  ] %>
<% end %>

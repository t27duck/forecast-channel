<% content_for :title, "Globe" %>
<% content_for :music_zone, "globe" %>
<% content_for :hide_app_nav, true %>
<%# Mapbox is only needed here, so it ships as its own bundle. %>
<% content_for :javascript do %>
  <%# No data-turbo-track here: a tracked asset that only some pages carry makes
      Turbo full-reload on the way in and on the way out. %>
  <%= javascript_include_tag "globe", type: "module" %>
<% end %>

<%# The globe is built to be left running — the chrome slides away, the cursor
    hides and it turns on its own — so it can't stay on the markers it fetched
    when it opened. This subscription lets a batch refresh tell it to re-read
    the feed; the signal carries no markup, since the temperatures on screen are
    converted per-visitor client-side. %>
<%= turbo_stream_from Location::WEATHER_STREAM %>

<div
  class="relative map-view"
  data-controller="globe"
  data-globe-token-value="<%= mapbox_token %>"
  data-globe-markers-url-value="<%= map_markers_path %>"
  data-globe-temperature-unit-value="<%= current_setting.temperature_unit %>"
  data-globe-tour-value="<%= tour_stops_value(@tour_stops) %>"
  <% if @focus %>data-globe-center-value="<%= [ @focus.longitude.to_f, @focus.latitude.to_f ].to_json %>"<% end %>
>
  <div data-globe-target="map" class="h-screen w-full bg-[#030a1b]"></div>

  <%# Wii-style control bar overlaid on the globe; faint until hovered. %>
  <div class="wii-top map-bar map-bar--top" data-controller="press">
    <div class="wii-bar__slot">
      <button type="button" class="wii-arrow" aria-label="Zoom out"
        data-action="globe#zoomOut" data-globe-target="zoomOut">
        <svg class="wii-zoom__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <line x1="8" y1="12" x2="16" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span class="wii-arrow__label">Zoom</span>
      </button>
    </div>
    <div class="wii-bar__slot wii-bar__slot--center">
      <button type="button" class="wii-arrow" aria-label="Next weather view"
        data-action="globe#next">
        <span class="wii-arrow__label">Next</span>
        <span class="wii-arrow__glyph">&#9654;</span>
      </button>
    </div>
    <div class="wii-bar__slot">
      <button type="button" class="wii-arrow" aria-label="Zoom in"
        data-action="globe#zoomIn" data-globe-target="zoomIn">
        <span class="wii-arrow__label">Zoom</span>
        <svg class="wii-zoom__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <line x1="8" y1="12" x2="16" y2="12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          <line x1="12" y1="8" x2="12" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <%# Green banner naming what the marker icons currently represent. %>
  <div class="map-banner" data-globe-target="banner">Current Weather</div>

  <%# Bottom bar: leave the globe, tilt it, reset the tilt, or set it touring. %>
  <div class="wii-bottom map-bar map-bar--bottom" data-controller="press">
    <div class="wii-bar__slot">
      <%# Straight to the forecast, not the root path: leaving the globe isn't
          an arrival, so it shouldn't play the loading screen again. %>
      <%= link_to "End", location_path(current_location), class: "wii-chrome-link" %>
    </div>
    <div class="wii-bar__slot">
      <button type="button" class="wii-arrow" aria-label="Increase tilt"
        data-action="globe#pitchUp" data-globe-target="pitchUp">
        <svg class="wii-pitch__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5.5 10 A8.5 8.5 0 0 1 18 13"/>
          <path d="M18 13 L13.6 13 M18 13 L18 8.6"/>
        </svg>
      </button>
    </div>
    <div class="wii-bar__slot">
      <button type="button" class="wii-arrow" aria-label="Decrease tilt"
        data-action="globe#pitchDown" data-globe-target="pitchDown">
        <svg class="wii-pitch__icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
          fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <g transform="translate(24,0) scale(-1,1)">
            <path d="M5.5 10 A8.5 8.5 0 0 1 18 13"/>
            <path d="M18 13 L13.6 13 M18 13 L18 8.6"/>
          </g>
        </svg>
      </button>
    </div>
    <div class="wii-bar__slot">
      <button type="button" class="wii-chrome-link" data-action="globe#resetPitch">Restore</button>
    </div>
    <div class="wii-bar__slot">
      <%# Play/stop share one button, the way the mute icon carries its own state
          (see locations/show). Nothing to tour with fewer than two stops. %>
      <button type="button" class="wii-arrow wii-tour" aria-label="Tour the world's cities"
        aria-pressed="false" data-action="globe#toggleTour" data-globe-target="tourButton"
        <%= "disabled" if @tour_stops.size < 2 %>>
        <span class="wii-arrow__label">Tour</span>
        <span class="wii-arrow__glyph wii-tour__play" aria-hidden="true">&#9654;</span>
        <span class="wii-arrow__glyph wii-tour__stop" aria-hidden="true">&#9632;</span>
      </button>
    </div>
  </div>

  <% if @locations.none? %>
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center px-4">
      <p class="rounded-md bg-black/50 px-4 py-2 text-center text-sm text-white">
        No locations yet — <%= link_to "add some", new_location_path, class: "pointer-events-auto underline" %> to see them on the globe.
      </p>
    </div>
  <% end %>
</div>

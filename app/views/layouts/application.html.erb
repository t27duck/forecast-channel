<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Forecast" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Forecast">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="turbo-prefetch" content="false">
    <meta name="turbo-cache-control" content="no-preview">
    <meta name="view-transition" content="same-origin">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Sun-behind-cloud on a Wii-blue tile; regenerate the raster pair from
        icon.svg with `ruby script/build_favicons.rb`. %>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
    <%# Page-specific bundles, after the main one so window.Stimulus exists. %>
    <%= yield :javascript %>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-900" data-music-zone="<%= content_for(:music_zone).presence || "current" %>">
    <%# Background music — uploaded at /sounds, persists across Turbo
        navigations (see jukebox_controller.js). A slot with no upload is blank,
        which the controller treats as "no track". %>
    <% tracks = music_track_paths %>
    <div id="jukebox" data-turbo-permanent
      data-controller="jukebox"
      data-jukebox-current-day-value="<%= tracks["current_day"] %>"
      data-jukebox-current-night-value="<%= tracks["current_night"] %>"
      data-jukebox-globe-day-value="<%= tracks["globe_day"] %>"
      data-jukebox-globe-night-value="<%= tracks["globe_night"] %>"></div>

    <% unless content_for?(:hide_app_nav) %>
      <nav class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-5xl items-center gap-6 px-4 py-3">
          <%= link_to "Forecast", root_path, class: "font-semibold text-slate-900" %>
          <%= link_to "Globe", map_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
          <%= link_to "Locations", locations_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
          <% if authenticated? %>
            <%= link_to "Sounds", sounds_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
            <%= link_to "Jobs", mission_control_jobs.root_path, class: "text-sm text-slate-600 hover:text-slate-900", data: { turbo: false } %>
          <% end %>
        </div>
      </nav>
    <% end %>

    <% if notice.present? %>
      <div class="mx-auto max-w-5xl px-4 pt-4">
        <p class="rounded-md bg-emerald-50 px-4 py-2 text-sm text-emerald-700"><%= notice %></p>
      </div>
    <% end %>

    <% if alert.present? %>
      <div class="mx-auto max-w-5xl px-4 pt-4">
        <p class="rounded-md bg-red-50 px-4 py-2 text-sm text-red-700"><%= alert %></p>
      </div>
    <% end %>

    <main>
      <%= yield %>
    </main>
  </body>
</html>

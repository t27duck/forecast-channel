<% content_for :title, "Choose Location" %>
<% content_for :hide_app_nav, true %>

<%
  prompt =
    if @locations then "Choose the location closest to where you live."
    elsif @states then "Choose the state or region closest to where you live."
    else "Choose the country closest to where you live."
    end
  # Nil on the first step of first-time setup: there is no settings page to go
  # back to until a location has been chosen.
  back_path =
    if @state.present? then settings_location_path(country: @country)
    elsif @country.present? then settings_location_path
    elsif current_location then settings_path
    end
%>

<div class="picker" data-controller="scroller">
  <div class="picker__prompt"><%= prompt %></div>

  <div class="picker__list" data-scroller-target="list">
    <% if @locations %>
      <% @locations.each do |location| %>
        <%= button_to location.name, settings_location_path, method: :patch,
          params: { current_location_id: location.id },
          class: "picker__row", form: { class: "picker__form" } %>
      <% end %>
      <% if @locations.empty? %>
        <div class="picker__empty">No locations here yet.</div>
      <% end %>
    <% elsif @states %>
      <% @states.each do |state| %>
        <%= link_to state, settings_location_path(country: @country, state: state), class: "picker__row" %>
      <% end %>
    <% else %>
      <%= render "settings/locations/use_current_location" %>
      <% @countries.each do |country| %>
        <%= link_to country, settings_location_path(country: country), class: "picker__row" %>
      <% end %>
      <% if @countries.empty? %>
        <div class="picker__empty">No locations yet — add some first.</div>
      <% end %>
    <% end %>
  </div>

  <div class="wii-bottom picker__bar">
    <div class="wii-bar__slot">
      <%= link_to "Back", back_path, class: "wii-chrome-link" if back_path %>
    </div>
    <div class="wii-bar__slot wii-bar__slot--center">
      <button type="button" class="wii-arrow" data-action="scroller#up" aria-label="Scroll up">
        <span class="wii-arrow__glyph">&#9650;</span>
      </button>
      <button type="button" class="wii-arrow" data-action="scroller#down" aria-label="Scroll down">
        <span class="wii-arrow__glyph">&#9660;</span>
      </button>
    </div>
    <div class="wii-bar__slot"></div>
  </div>
</div>

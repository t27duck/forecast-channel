<% content_for :title, "Sign in" %>
<% content_for :hide_app_nav, true %>

<div class="flex min-h-screen items-center justify-center px-4 py-12">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <h1 class="text-2xl font-semibold text-slate-900">Forecast</h1>
      <p class="mt-1 text-sm text-slate-500">Sign in to manage locations</p>
    </div>

    <%= form_with url: session_path, class: "space-y-4 rounded-xl border border-slate-200 bg-white p-6 shadow-sm" do |form| %>
      <div>
        <%= form.label :username, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
          value: params[:username],
          class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-medium text-slate-700" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
          class: "mt-1 block w-full rounded-md border border-slate-300 px-3 py-2 text-slate-900 shadow-sm focus:border-sky-500 focus:outline-none focus:ring-1 focus:ring-sky-500" %>
      </div>

      <%= form.submit "Sign in",
        class: "w-full cursor-pointer rounded-md bg-sky-600 px-4 py-2 font-medium text-white transition hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2" %>
    <% end %>
  </div>
</div>
